{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SetupBenchmarkContract",
  "type": "object",
  "required": [
    "stage_status",
    "download_ok",
    "integrity_ok",
    "recommended_model",
    "recommended_context_window",
    "benchmark_tps",
    "vram_used_mb"
  ],
  "properties": {
    "stage_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["SUCCESS", "FAILED", "SKIPPED", "RUNNING"]
      }
    },
    "download_ok": {
      "type": "boolean"
    },
    "integrity_ok": {
      "type": "boolean"
    },
    "recommended_model": {
      "type": "string",
      "minLength": 1
    },
    "recommended_context_window": {
      "type": "integer",
      "enum": [2048, 4096, 8192, 16384, 32768]
    },
    "benchmark_tps": {
      "type": "number",
      "minimum": 0.0
    },
    "vram_used_mb": {
      "type": "integer",
      "minimum": 0
    },
    "benchmark_timestamp": {
      "type": "string"
    }
  }
}
