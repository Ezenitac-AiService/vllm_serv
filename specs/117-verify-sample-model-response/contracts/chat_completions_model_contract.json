{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatCompletionsModelParityContract",
  "description": "OpenAI-compatible /v1/chat/completions request and response contract for model ID parity validation",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "required": ["model", "messages"],
      "properties": {
        "model": {
          "type": "string",
          "description": "Requested model identifier (e.g., 'qwen3.5-4b', 'gemma4-e4b')"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["id", "object", "model", "choices"],
      "properties": {
        "id": { "type": "string" },
        "object": { "type": "string", "enum": ["chat.completion"] },
        "model": {
          "type": "string",
          "description": "MUST match the requested model parameter exactly"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "message"],
            "properties": {
              "index": { "type": "integer" },
              "message": {
                "type": "object",
                "required": ["role", "content"],
                "properties": {
                  "role": { "type": "string" },
                  "content": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
