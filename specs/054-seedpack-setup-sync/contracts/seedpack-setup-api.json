{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeedPackAndSetupSyncContract",
  "description": "JSON Schema contract for scripts and configuration sync validation",
  "type": "object",
  "properties": {
    "firewall_ports": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 4,
      "uniqueItems": true,
      "default": [8081, 8089, 8090, 8091]
    },
    "required_files": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "src/core/auxiliary_manager.py" }
    },
    "seed_db_endpoints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 3,
      "default": ["/v1/chat/completions", "/v1/embeddings", "/v1/rerank"]
    }
  },
  "required": ["firewall_ports", "required_files", "seed_db_endpoints"]
}
