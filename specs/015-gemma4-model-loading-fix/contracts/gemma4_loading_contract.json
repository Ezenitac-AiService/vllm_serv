{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gemma4LoadingContract",
  "description": "Validation schema for Gemma 4 model loading and 100% CUDA VRAM offloading contract",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "enum": ["gemma4-e2b", "gemma4-e4b", "gemma4-12b"]
    },
    "has_mmproj_file": {
      "type": "boolean",
      "const": true
    },
    "mmproj_cli_arg_present": {
      "type": "boolean",
      "const": true
    },
    "offloaded_layers": {
      "type": "integer",
      "minimum": 1
    },
    "total_layers": {
      "type": "integer",
      "minimum": 1
    },
    "is_fully_offloaded": {
      "type": "boolean",
      "const": true
    },
    "healthcheck_status": {
      "type": "integer",
      "const": 200
    }
  },
  "required": [
    "model_id",
    "has_mmproj_file",
    "mmproj_cli_arg_present",
    "offloaded_layers",
    "total_layers",
    "is_fully_offloaded",
    "healthcheck_status"
  ]
}
