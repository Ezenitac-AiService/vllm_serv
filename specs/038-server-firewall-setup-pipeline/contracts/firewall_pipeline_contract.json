{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FirewallPipelineContracts",
  "type": "object",
  "definitions": {
    "FirewallStatusResponse": {
      "type": "object",
      "properties": {
        "system_type": { "type": "string" },
        "is_firewall_active": { "type": "boolean" },
        "port_open_success": { "type": "boolean" },
        "requires_sudo": { "type": "boolean" },
        "guide_message": { "type": "string" }
      },
      "required": ["system_type", "is_firewall_active", "port_open_success", "requires_sudo", "guide_message"]
    },
    "SocketCheckRequest": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "timeout_s": { "type": "number" }
      },
      "required": ["host", "port"]
    }
  }
}
