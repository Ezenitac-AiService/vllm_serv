{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerConfigSchema",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "default": "0.0.0.0"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "default": 8081
    },
    "allowed_subnets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["127.0.0.1", "192.168.0.0/24"]
    },
    "vram_limit_mb": {
      "type": "integer",
      "default": 11264
    },
    "health_timeout_sec": {
      "type": "integer",
      "default": 120
    },
    "connection_pool": {
      "type": "object",
      "properties": {
        "max_keepalive_connections": {
          "type": "integer",
          "default": 20
        },
        "max_connections": {
          "type": "integer",
          "default": 100
        }
      },
      "required": ["max_keepalive_connections", "max_connections"]
    }
  },
  "required": ["host", "port", "allowed_subnets", "vram_limit_mb", "health_timeout_sec"]
}
