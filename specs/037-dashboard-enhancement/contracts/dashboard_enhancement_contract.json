{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DashboardEnhancementContracts",
  "type": "object",
  "definitions": {
    "CapabilitiesResponse": {
      "type": "object",
      "properties": {
        "platform_profile": { "type": "string" },
        "available_models": {
          "type": "array",
          "items": { "type": "string" }
        },
        "current_model": { "type": "string" },
        "current_n_ctx": { "type": "integer" }
      },
      "required": ["platform_profile", "available_models", "current_model", "current_n_ctx"]
    },
    "ApplyConfigRequest": {
      "type": "object",
      "properties": {
        "model_id": { "type": "string" },
        "n_ctx": { "type": "integer" }
      },
      "required": ["model_id", "n_ctx"]
    },
    "AuditLogResponse": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": { "type": "string" },
              "client_ip": { "type": "string" },
              "subnet_allowed": { "type": "boolean" },
              "endpoint": { "type": "string" },
              "status_code": { "type": "integer" },
              "process_time_ms": { "type": "number" }
            },
            "required": ["timestamp", "client_ip", "subnet_allowed", "endpoint", "status_code"]
          }
        }
      },
      "required": ["logs"]
    }
  }
}
