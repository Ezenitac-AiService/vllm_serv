{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelCatalogSchema",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_.-]+$": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "repo_id": { "type": "string" },
        "filename": { "type": "string" },
        "clip_filename": { "type": ["string", "null"] },
        "target_dir": { "type": "string" },
        "model_path": { "type": "string" },
        "clip_path": { "type": ["string", "null"] },
        "chat_template": { "type": "string" },
        "default_n_ctx": { "type": "integer", "minimum": 512 },
        "vram_est_mb": { "type": "integer", "minimum": 100 },
        "requires_mmproj": { "type": "boolean" },
        "quant_type": { "type": "string" },
        "size_gb": { "type": "number", "minimum": 0.1 }
      },
      "required": [
        "name",
        "repo_id",
        "filename",
        "target_dir",
        "model_path",
        "chat_template",
        "default_n_ctx",
        "vram_est_mb",
        "requires_mmproj",
        "quant_type",
        "size_gb"
      ]
    }
  }
}
