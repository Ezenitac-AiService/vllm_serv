{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LegacyArchiveContract",
  "type": "object",
  "properties": {
    "archive_directory": {
      "type": "string",
      "default": ".legacy"
    },
    "archived_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        ".legacy/ATEAM_ExtractionItem.py",
        ".legacy/BTEAM_ExtractionItem.py",
        ".legacy/get-pip.py",
        ".legacy/benchmark_results.json",
        ".legacy/make_seed_pack.sh",
        ".legacy/setup.sh",
        ".legacy/start_server.sh",
        ".legacy/status_server.sh",
        ".legacy/stop_server.sh"
      ]
    },
    "test_suite_status": {
      "type": "string",
      "enum": ["PASS", "FAIL"],
      "default": "PASS"
    }
  },
  "required": ["archive_directory", "archived_files", "test_suite_status"]
}
