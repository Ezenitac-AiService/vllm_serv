{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthProbeContract",
  "type": "object",
  "properties": {
    "port_checks": {
      "type": "object",
      "properties": {
        "8081": { "type": "string", "enum": ["OPEN", "CLOSED"] },
        "8082": { "type": "string", "enum": ["OPEN", "CLOSED"] }
      },
      "required": ["8081", "8082"]
    },
    "endpoint_probes": {
      "type": "object",
      "properties": {
        "/v1/models": { "type": "integer", "enum": [200] },
        "/health": { "type": "integer", "enum": [200] },
        "/v1/chat/completions": { "type": "integer", "enum": [200] }
      },
      "required": ["/v1/models", "/health", "/v1/chat/completions"]
    },
    "dashboard_e2e": {
      "type": "string",
      "enum": ["ON", "OFF"]
    }
  },
  "required": ["port_checks", "endpoint_probes", "dashboard_e2e"]
}
