{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LegacyExtractionLocalLLMContract",
  "description": "Interface contract for legacy extraction scripts refactored to local server vLLM endpoint",
  "type": "object",
  "properties": {
    "local_llm_config": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string",
          "default": "http://10.0.0.41:8000/v1",
          "pattern": "^http://(10\\.\\d+\\.\\d+\\.\\d+|192\\.168\\.\\d+\\.\\d+):\\d+/v1$"
        },
        "api_key": {
          "type": "string",
          "default": "EMPTY"
        },
        "supported_models": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["gemma4-e2b", "gemma4-e4b", "qwen3.5-2b", "qwen3.5-4b", "qwen3.5-9b"]
          }

        }
      },
      "required": ["base_url", "api_key"]
    },
    "output_structure": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "target", "sentence", "refined_sentence"]
          }
        }
      },
      "required": ["results"]
    }
  }
}
