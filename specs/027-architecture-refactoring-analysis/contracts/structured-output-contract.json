{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuredOutputContract",
  "type": "object",
  "properties": {
    "response_format": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "json_object", "json_schema"]
        },
        "json_schema": {
          "type": "object"
        }
      },
      "required": ["type"]
    },
    "speculative_decoding": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "draft_model": {
          "type": "string"
        }
      }
    }
  }
}
