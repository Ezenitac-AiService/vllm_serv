{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerNetworkConfigContract",
  "type": "object",
  "properties": {
    "bind_host": {
      "type": "string",
      "default": "0.0.0.0",
      "description": "Host IP address to bind API server and llama-server sub-processes"
    },
    "api_port": {
      "type": "integer",
      "default": 8081,
      "minimum": 1024,
      "maximum": 65535
    },
    "llama_server_port": {
      "type": "integer",
      "default": 8089,
      "minimum": 1024,
      "maximum": 65535
    },
    "allowed_subnets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "127.0.0.1/32",
        "192.168.0.0/16",
        "10.0.0.0/8"
      ]
    },
    "firewall_auto_allow": {
      "type": "boolean",
      "default": true
    },
    "detected_interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "ip_address": { "type": ["string", "null"] },
          "is_active": { "type": "boolean" },
          "is_usable_lan": { "type": "boolean" }
        },
        "required": ["name", "is_active", "is_usable_lan"]
      }
    }
  },
  "required": ["bind_host", "api_port", "llama_server_port", "allowed_subnets", "firewall_auto_allow"]
}
