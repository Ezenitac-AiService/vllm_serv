{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatCompletionEndpointContract",
  "description": "API contract for OpenAI compliant /v1/chat/completions endpoint ensuring HTTP 200 response without 503 errors.",
  "type": "object",
  "required": [
    "request",
    "response"
  ],
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "method",
        "path",
        "body"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "POST"
          ]
        },
        "path": {
          "type": "string",
          "enum": [
            "/v1/chat/completions"
          ]
        },
        "body": {
          "type": "object",
          "required": [
            "model",
            "messages"
          ],
          "properties": {
            "model": {
              "type": "string",
              "example": "qwen3.5-4b"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "content"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "status_code",
        "body"
      ],
      "properties": {
        "status_code": {
          "type": "integer",
          "enum": [
            200
          ]
        },
        "body": {
          "type": "object",
          "required": [
            "id",
            "object",
            "choices",
            "usage"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "object": {
              "type": "string",
              "enum": [
                "chat.completion"
              ]
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "index",
                  "message",
                  "finish_reason"
                ],
                "properties": {
                  "index": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "object",
                    "required": [
                      "role",
                      "content"
                    ]
                  },
                  "finish_reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
