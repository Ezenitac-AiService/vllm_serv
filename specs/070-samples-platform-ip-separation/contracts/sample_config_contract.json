{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SampleClientConfig",
  "type": "object",
  "properties": {
    "server_host": {
      "type": "string",
      "format": "uri",
      "default": "http://192.168.0.100",
      "description": "Target server URL for service platform API requests"
    },
    "main_port": {
      "type": "integer",
      "default": 8081,
      "description": "Main LLM inference port"
    },
    "embedding_port": {
      "type": "integer",
      "default": 8090,
      "description": "Embedding model inference port"
    },
    "rerank_port": {
      "type": "integer",
      "default": 8091,
      "description": "Reranker model inference port"
    }
  },
  "required": ["server_host"]
}
