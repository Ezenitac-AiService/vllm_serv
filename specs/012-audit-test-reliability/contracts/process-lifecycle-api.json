{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProcessLifecycleAPIContract",
  "description": "Contract for ProcessManager lifecycle state transitions and port management",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["UNLOADED", "DOWNLOADING", "LOADING", "READY", "ERROR"]
    },
    "model_id": {
      "type": ["string", "null"]
    },
    "port": {
      "type": "integer",
      "default": 8081
    },
    "pid": {
      "type": ["integer", "null"]
    },
    "vram_offloaded_100pct": {
      "type": "boolean"
    },
    "error_message": {
      "type": ["string", "null"]
    }
  },
  "required": ["status", "port", "vram_offloaded_100pct"]
}
