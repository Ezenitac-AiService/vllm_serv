{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WheelVerificationContract",
  "description": "Interface Contract for Post-Build Binary Inspection and Wheel Verification in verify_wheel_binary.py and make_seed_pack.sh",
  "type": "object",
  "properties": {
    "cli_command": {
      "type": "string",
      "example": "uv run python scripts/verify_wheel_binary.py wheels/legacy_i7_930/llama_cpp_python-0.3.34-py3-none-linux_x86_64.whl"
    },
    "classification_rules": {
      "type": "object",
      "properties": {
        "cuda_device_libraries": {
          "type": "array",
          "items": { "type": "string" },
          "example": ["ggml-cuda.so", "libggml-cuda.so"]
        },
        "cpu_host_libraries": {
          "type": "array",
          "items": { "type": "string" },
          "example": ["ggml-cpu.so", "libllama.so", "libggml-base.so", "libggml.so"]
        }
      }
    },
    "expected_outcome": {
      "type": "object",
      "properties": {
        "exit_code": { "type": "integer", "enum": [0] },
        "cuda_enabled": { "type": "boolean", "enum": [true] },
        "cpu_host_avx_clean": { "type": "boolean", "enum": [true] },
        "false_positives": { "type": "integer", "enum": [0] }
      }
    }
  }
}
