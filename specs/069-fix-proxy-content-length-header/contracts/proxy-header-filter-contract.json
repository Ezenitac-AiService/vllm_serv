{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reverse Proxy Response Header Filter Contract",
  "type": "object",
  "properties": {
    "target_endpoints": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["/v1/chat/completions", "/v1/embeddings", "/v1/rerank"]
    },
    "excluded_headers": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["content-length", "transfer-encoding", "connection", "content-encoding"]
    }
  }
}
