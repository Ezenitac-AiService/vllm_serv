{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComprehensiveBenchmarkReportSchema",
  "type": "object",
  "required": ["models", "generated_at", "gpu_environment"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "gpu_environment": {
      "type": "object",
      "required": ["gpu_name", "total_vram_mb", "cuda_version"],
      "properties": {
        "gpu_name": { "type": "string" },
        "total_vram_mb": { "type": "number" },
        "cuda_version": { "type": "string" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["model_id", "quant_type", "load_time_sec", "ttft_ms", "tpot_tok_per_sec", "peak_vram_mb", "avg_quality_score", "qualitative_samples", "context_scaling_metrics"],
        "properties": {
          "model_id": { "type": "string" },
          "quant_type": { "type": "string" },
          "load_time_sec": { "type": "number" },
          "ttft_ms": { "type": "number" },
          "tpot_tok_per_sec": { "type": "number" },
          "peak_vram_mb": { "type": "number" },
          "avg_quality_score": { "type": "number" },
          "is_oom": { "type": "boolean" },
          "error_message": { "type": ["string", "null"] },
          "qualitative_samples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["prompt_id", "prompt_text", "golden_ground_truth", "model_response", "rouge_l_f1", "exact_match", "json_schema_valid", "error_tags"],
              "properties": {
                "prompt_id": { "type": "string" },
                "prompt_text": { "type": "string" },
                "golden_ground_truth": { "type": "string" },
                "model_response": { "type": "string" },
                "rouge_l_f1": { "type": "number" },
                "exact_match": { "type": "boolean" },
                "json_schema_valid": { "type": "boolean" },
                "error_tags": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "context_scaling_metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["n_ctx", "peak_vram_mb", "ttft_ms", "tpot_tok_per_sec", "is_oom"],
              "properties": {
                "n_ctx": { "type": "integer" },
                "peak_vram_mb": { "type": "number" },
                "ttft_ms": { "type": "number" },
                "tpot_tok_per_sec": { "type": "number" },
                "is_oom": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
