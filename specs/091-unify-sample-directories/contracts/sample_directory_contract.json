{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SampleDirectoryValidationContract",
  "description": "Validation contract for single sample/ directory unification and removal of samples symlink",
  "type": "object",
  "properties": {
    "primary_directory": {
      "type": "string",
      "const": "sample"
    },
    "symlink_deleted": {
      "type": "boolean",
      "const": true
    },
    "total_scripts_count": {
      "type": "integer",
      "minimum": 22
    },
    "script_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "httpx_and_openai_pairs"
      }
    }
  },
  "required": [
    "primary_directory",
    "symlink_deleted",
    "total_scripts_count"
  ]
}
